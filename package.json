{
  "name": "mvc-front-sdk",
  "version": "0.1.0",
  "description": "MVC Front SDK - A modern frontend MVC SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "reflect-metadata"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mvc",
    "frontend",
    "sdk",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bruxx-6243/mvc-front-sdk.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --minify",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:all": "bun run build && bun run build:types",
    "prepublishOnly": "bun run build:all",
    "prepack": "bun run build:all",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./test-setup.ts",
    "test:watch": "bun test --watch --preload ./test-setup.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@>=9.0.0",
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
